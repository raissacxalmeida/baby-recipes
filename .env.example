# Copy this file to .env and fill in the blanks. Never commit .env.

# Database password. Use letters and numbers only (it is placed inside a web address).
POSTGRES_PASSWORD=

# Your OpenAI API key.
OPENAI_API_KEY=

# The address people type to open the site from the home network, for example
# http://my-mac.local:3000 (or http://192.168.1.20:3000). Invite and reset links are built from it.
PUBLIC_URL=http://localhost:3000

# Optional: extra host names the site answers to, separated by commas. Leave empty to allow
# the PUBLIC_URL host plus localhost and 127.0.0.1.
ALLOWED_HOSTS=

# Keep false on a home network over plain HTTP. Browsers drop Secure cookies on plain HTTP.
COOKIE_SECURE=false
